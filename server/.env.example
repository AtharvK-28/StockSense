# Local PostgreSQL — no hosted database required.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/stocksense?schema=public"

# Long random string used to sign session tokens.
JWT_SECRET="change-me-to-a-long-random-string"

PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# When true, the forgot-password API also returns the OTP so the flow can be demoed
# without an email inbox. Never enable this in production.
OTP_DEV_ECHO=true

# Optional SMTP settings for sending OTP emails (any SMTP server works, e.g. a Gmail app password).
# Leave SMTP_HOST empty to print OTPs to the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="StockSense <no-reply@stocksense.local>"
